# ---- 1단계: 프런트엔드 에셋 빌드 (Vite) ----
FROM node:20-alpine AS assets

WORKDIR /app

# Vite 빌드 시점에 번들에 박히는 공개 설정값 (Railway 빌드 ARG 로 주입).
# 운영에서는 공개 도메인/443/https 로, nginx 가 /app 를 reverb 로 프록시한다.
ARG VITE_APP_NAME
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ARG VITE_REVERB_PORT=443
ARG VITE_REVERB_SCHEME=https
ENV VITE_APP_NAME=${VITE_APP_NAME} \
    VITE_REVERB_APP_KEY=${VITE_REVERB_APP_KEY} \
    VITE_REVERB_HOST=${VITE_REVERB_HOST} \
    VITE_REVERB_PORT=${VITE_REVERB_PORT} \
    VITE_REVERB_SCHEME=${VITE_REVERB_SCHEME}

# 의존성 설치 (lockfile 기반 재현 설치)
COPY package.json package-lock.json ./
RUN npm ci

# 소스 복사 후 프로덕션 에셋 빌드 → /app/public/build 생성
COPY . .
RUN npm run build


# ---- 2단계: PHP 런타임 ----
FROM php:8.3-fpm

ENV TZ=Asia/Seoul

RUN apt-get update && apt-get install -y \
    build-essential nginx supervisor \
    libpng-dev libjpeg62-turbo-dev libfreetype6-dev \
    libzip-dev libonig-dev libxml2-dev libssl-dev libpq-dev \
    zip unzip jpegoptim optipng pngquant gifsicle \
    vim git curl tzdata && \
    docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install pdo_mysql pdo_pgsql pgsql mbstring zip exif pcntl bcmath gd && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone && \
    echo "date.timezone = Asia/Seoul" > /usr/local/etc/php/conf.d/timezone.ini

RUN pecl install redis && docker-php-ext-enable redis

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

ENV COMPOSER_ALLOW_SUPERUSER=1

WORKDIR /var/www/html

COPY . .

# 1단계에서 빌드한 Vite 에셋을 복사 (public/build 는 .gitignore 라 레포에 없음)
COPY --from=assets /app/public/build ./public/build

COPY docker/php.ini /usr/local/etc/php/php.ini
COPY docker/nginx/conf.d/default-railway.conf /etc/nginx/conf.d/default.conf
COPY docker/supervisor-railway.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/motd-railway.sh /etc/profile.d/motd.sh

RUN chmod +x /etc/profile.d/motd.sh && \
    echo 'source /etc/profile.d/motd.sh' >> /root/.bashrc && \
    echo 'service() { if [ $# -eq 2 ]; then supervisorctl $2 $1; else supervisorctl $@; fi }' >> /root/.bashrc

RUN composer install --no-interaction --prefer-dist --optimize-autoloader --no-dev --no-scripts

RUN chown -R www-data:www-data /var/www/html/storage /var/www/html/bootstrap/cache

EXPOSE 8080 9997

CMD php artisan package:discover --ansi && supervisord -c /etc/supervisor/conf.d/supervisord.conf

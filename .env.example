# ===== Laravel Reverb (WebSocket 실시간) =====
# 앱 자격증명 (php artisan reverb:install 시 자동 생성됨, 운영은 별도 발급 권장)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Reverb 서버가 컨테이너 내부에서 바인딩하는 주소/포트.
# - 로컬 docker-compose: 전용 reverb 컨테이너가 8080 바인딩, 호스트에 9997 로 공개.
# - 운영(Railway, 단일 컨테이너): nginx 가 8080 을 쓰므로 reverb 는 9997 로 바인딩.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# 서버 측(PHP 브로드캐스터)이 접속하는 주소.
# - 로컬: 같은 네트워크의 reverb 서비스(reverb:8080)
# - 운영: 127.0.0.1:9997 (같은 컨테이너 내 reverb)
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# 클라이언트(브라우저)가 접속하는 주소.
# - 로컬: localhost / 9997 / http
# - 운영(Railway): 공개 도메인 / 443 / https (nginx 가 /app 를 reverb 로 프록시)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=9997
VITE_REVERB_SCHEME=http

# ===== 텔레그램 봇 (운영진 알림) =====
# @BotFather 로 봇을 만들고 받은 토큰, 그리고 알림을 받을 채팅방/개인의 chat id.
# 둘 다 채워야 전송되며, 비어 있으면 알림 전송을 조용히 건너뛴다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_INVITE_LINK=
